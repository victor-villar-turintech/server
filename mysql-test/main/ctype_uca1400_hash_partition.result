# 3. Equality self-join: every pair equal under the collation, in both directions (compare path, both operand orders).
SELECT COUNT(*) AS equal_pairs_ai FROM corpus a JOIN corpus b
ON a.s COLLATE utf8mb4_uca1400_ai_ci = b.s COLLATE utf8mb4_uca1400_ai_ci AND a.id < b.id;
equal_pairs_ai
40
