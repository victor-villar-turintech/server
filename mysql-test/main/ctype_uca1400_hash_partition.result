#
# Regression test for the UCA collation hot-path optimisation (hash, compare, sort key).
# The expected results were recorded on the UNMODIFIED collation code. Partition placement
# under PARTITION BY KEY depends on the collation hash, so any change in hash output moves
# rows between partitions and fails this test; DISTINCT, GROUP BY, equality joins and the
# MEMORY hash index exercise the compare and hash paths together.
#
SET NAMES utf8mb4;
# A multilingual corpus: ASCII, 2-byte Latin and Cyrillic, 3-byte CJK and symbols, 4-byte emoji,
# expansions (ß, ligatures), canonically equivalent sequences, ignorables, trailing spaces.
CREATE TABLE corpus (id INT PRIMARY KEY, s VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin);
INSERT INTO corpus VALUES
(1,''),(2,' '),(3,'a'),(4,'A'),(5,'a '),(6,'a  '),(7,' a'),(8,'ab'),(9,'ba'),(10,'abc'),
(11,'Hello'),(12,'HELLO'),(13,'hello world'),(14,'hello  world'),
(15,'café'),(16,'CAFE'),(17,'cafe'),(18,CONCAT('cafe',_utf8mb4 0xCC81)),(19,'Straße'),(20,'Strasse'),(21,'STRASSE'),
(22,'ﬁ'),(23,'fi'),(24,'æble'),(25,'aeble'),(26,'Ångström'),(27,'angstrom'),
(28,'Жж'),(29,'жЖ'),(30,'αβγ'),(31,'ΑΒΓ'),(32,'Ελλάδα'),
(33,'中文'),(34,'日本語テキスト'),(35,'한국어'),(36,'€100'),(37,'100€'),
(38,'😀'),(39,'😀😀'),(40,'a😀b'),(41,'𝔘𝔫𝔦𝔠𝔬𝔡𝔢'),
(42,CONCAT('a',_utf8mb4 0xE2808B,'b')),(43,CONCAT('a',_utf8mb4 0xC2AD,'b')),(44,'ab'),
(45,'L·L'),(46,'ll'),(47,'ch'),(48,'Ch'),
(49,REPEAT('x',63)),(50,REPEAT('x',62)),(51,CONCAT(REPEAT('x',62),' ')),(52,REPEAT('é',32)),(53,REPEAT('中',21)),
(54,'The quick brown fox'),(55,'the QUICK brown FOX'),(56,'The quick brown fox '),
(57,'naïve'),(58,'naive'),(59,'NAÏVE'),(60,'résumé'),(61,'resume'),(62,'Résumé ');
# 1. Partition placement by the collation hash: three collations, eight partitions each.
CREATE TABLE p_ai (s VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_uca1400_ai_ci) PARTITION BY KEY(s) PARTITIONS 8;
CREATE TABLE p_as (s VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_uca1400_as_cs) PARTITION BY KEY(s) PARTITIONS 8;
CREATE TABLE p_np (s VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_uca1400_nopad_ai_ci) PARTITION BY KEY(s) PARTITIONS 8;
INSERT INTO p_ai SELECT s FROM corpus;
INSERT INTO p_as SELECT s FROM corpus;
INSERT INTO p_np SELECT s FROM corpus;
