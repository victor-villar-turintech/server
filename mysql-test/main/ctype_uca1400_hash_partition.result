# 2. Equality classes under each collation: DISTINCT and GROUP BY counts, and the members of every class.
SELECT COUNT(DISTINCT s COLLATE utf8mb4_uca1400_ai_ci) AS distinct_ai,
COUNT(DISTINCT s COLLATE utf8mb4_uca1400_as_cs) AS distinct_as,
COUNT(DISTINCT s COLLATE utf8mb4_uca1400_nopad_ai_ci) AS distinct_np FROM corpus;
distinct_ai	distinct_as	distinct_np
35	53	41
SELECT MIN(id) AS class_rep, COUNT(*) AS n, GROUP_CONCAT(id ORDER BY id) AS members
FROM corpus GROUP BY s COLLATE utf8mb4_uca1400_ai_ci HAVING n > 1 ORDER BY class_rep;
